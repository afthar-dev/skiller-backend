NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://skiller:skiller@localhost:5432/skiller
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-random-32+-char-secret
OTP_PEPPER=change-me-to-a-random-32+-char-secret
PLAYBACK_SECRET=change-me-to-a-random-32+-char-secret
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app; used for links in emails (org invites). A trailing slash is tolerated.
WEB_BASE_URL=http://localhost:5173
COOKIE_DOMAIN=localhost
R2_ACCOUNT_ID=test
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_PUBLIC_BUCKET=skiller-public
R2_PRIVATE_BUCKET=skiller-private
R2_PUBLIC_BASE_URL=http://localhost:9000/skiller-public
R2_PLAYBACK_BASE_URL=http://localhost:8787
RESEND_API_KEY=re_test
RESEND_FROM_ADDRESS=Skiller <no-reply@skiller.test>
RESEND_WEBHOOK_SECRET=whsec_dGVzdHNlY3JldA==
# Razorpay (payments, subscriptions). Test-mode keys locally; the webhook secret is the one set on the Razorpay dashboard webhook.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
# RazorpayX (payouts): the account number payouts debit, and the secret of its own dashboard webhook.
RAZORPAYX_ACCOUNT_NUMBER=2323230000000001
RAZORPAYX_WEBHOOK_SECRET=replace-me
# Optional secret (32+ chars) that keys the HMAC of PAN numbers for duplicate detection; defaults to OTP_PEPPER. Changing it breaks matching with older accounts.
# KYC_PEPPER=change-me-to-a-random-32+-char-secret
SUPER_ADMIN_EMAIL=admin@skiller.test
# Reverse-proxy hops in front of the API (0 = direct). Needed for correct per-IP rate limits.
TRUST_PROXY=0

# Optional: S3-compatible endpoint override (MinIO for local dev). Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=http://localhost:9000
# Optional: ffmpeg/ffprobe binaries for the worker (default: on PATH)
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Optional: Sentry error reporting (server errors only). Unset = disabled.
# SENTRY_DSN=
# Optional: pino log level (default info; logs are JSON in production, pretty in development, silent in tests)
# LOG_LEVEL=info

# DEMO image (free tier only): database update + API + worker + ffmpeg in ONE container, started by scripts/start-demo.sh.
# Used by render.demo.yaml. Production uses Dockerfile (API) and Dockerfile.worker (worker) as separate services.
FROM node:24-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.17.1 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY prisma ./prisma
RUN pnpm exec prisma generate
COPY tsconfig.json tsconfig.build.json tsconfig.scripts.json nest-cli.json ./
COPY src ./src
COPY scripts ./scripts
# dist/main.js (API), dist/worker.js (worker), dist/release/* (seed + permission sync)
RUN pnpm build

FROM node:24-bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production \
    FFMPEG_PATH=ffmpeg \
    FFPROBE_PATH=ffprobe
# Full node_modules: the prisma CLI runs `migrate deploy` from this image as the non-root user.
COPY --chown=node:node --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/prisma ./prisma
COPY assets ./assets
COPY scripts/start-demo.sh ./start-demo.sh
USER node
EXPOSE 4000
CMD ["sh", "./start-demo.sh"]

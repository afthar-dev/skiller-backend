{
  "name": "skiller-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build && tsc -p tsconfig.scripts.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.ts\"",
    "test": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:all": "jest --runInBand",
    "test:edge": "pnpm --dir edge/playback-gate test",
    "db:migrate:new": "prisma migrate dev --skip-seed --name",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:sync-permissions": "ts-node scripts/sync-permissions.ts",
    "release": "prisma migrate deploy && node dist/release/scripts/sync-permissions.js",
    "release:seed": "prisma migrate deploy && node dist/release/prisma/seed.js",
    "openapi:export": "ts-node scripts/export-openapi.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "@react-email/components": "^1.0.12",
    "@sentry/nestjs": "^11.10.0",
    "bullmq": "^6.5.4",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^14.3.3",
    "nestjs-pino": "^5.3.1",
    "pdfkit": "0.17.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "svix": "1.45.1",
    "uuid": "^10.0.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/ffprobe-static": "^2.0.3",
    "@types/html-to-text": "^9.0.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.5",
    "express": "^5.2.1",
    "fast-check": "^4.10.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "pdf-parse": "1.1.1",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  }
}

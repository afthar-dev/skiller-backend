generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── admin ───────────────────────────────────────────────────────────────

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  rules     Json?
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}

// ─── outbox ──────────────────────────────────────────────────────────────

model OutboxEvent {
  id          String    @id @default(uuid(7))
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)

  /// Set when delivery to the handlers was given up (all job attempts failed); lastError is the final error message.
  deadAt    DateTime?
  lastError String?

  /// Relay claim: set (with a per-cycle token) when a relay picks the row up; reclaimable if publishedAt stays null for 60 s.
  claimedAt  DateTime?
  claimToken String?

  @@index([publishedAt])
  @@index([deadAt])
  @@map("outbox_events")
}

// ─── mail ────────────────────────────────────────────────────────────────

model EmailSuppression {
  email     String   @id
  reason    String
  createdAt DateTime @default(now())

  @@map("email_suppressions")
}

// ─── identity ────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OtpPurpose {
  LOGIN
  STEP_UP
}

model User {
  id              String     @id @default(uuid(7))
  email           String     @unique // stored lower-case
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions  Session[]
  roles     UserRole[]
  profile   Profile?
  ownedOrgs Organization[]

  // text_pattern_ops makes LIKE 'prefix%' index-backed regardless of collation (admin search).
  @@index([email(ops: raw("text_pattern_ops"))], map: "users_email_pattern_idx")
  @@map("users")
}

model OtpChallenge {
  id         String     @id @default(uuid(7))
  email      String
  purpose    OtpPurpose
  userId     String?
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
  @@map("otp_challenges")
}

model Session {
  id            String    @id @default(uuid(7))
  userId        String
  familyId      String
  refreshHash   String    @unique
  previousHash  String?   @unique
  /// Hashes of tokens older than previousHash (newest first, capped): presenting one is reuse, not a race.
  retiredHashes String[]  @default([])
  rotatedAt     DateTime?
  userAgent     String
  ip            String
  lastUsedAt    DateTime
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([retiredHashes], type: Gin)
  @@map("sessions")
}

// ─── rbac ────────────────────────────────────────────────────────────────

enum RoleScope {
  PLATFORM
  ORG
}

model Permission {
  id          String   @id @default(uuid(7))
  key         String   @unique
  description String
  module      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String    @id @default(uuid(7))
  key         String    @unique
  name        String
  scope       RoleScope
  isSystem    Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// orgId is NULL for platform-wide grants. The unique index is recreated as NULLS NOT DISTINCT in the migration
// (Postgres 15+), so a platform grant cannot be duplicated either.
model UserRole {
  id          String    @id @default(uuid(7))
  userId      String
  roleId      String
  orgId       String?
  grantedById String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, orgId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── audit ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid(7))
  actorId    String?
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  ip         String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ─── users (profiles) ────────────────────────────────────────────────────

// handle is stored lower-case, so a plain unique index gives case-insensitive uniqueness. Always normalise before write/lookup.
model Profile {
  userId            String        @id
  handle            String        @unique
  displayName       String
  headline          String?
  about             String?
  avatarAssetId     String?
  bannerAssetId     String?
  location          String?
  links             Json          @default("[]")
  followersCount    Int           @default(0)
  followingCount    Int           @default(0)
  isCreator         Boolean       @default(false)
  verifiedAt        DateTime?
  /// Who may start a conversation with this person. FOLLOWING = people they follow. A gig inquiry reaches the seller of a live gig regardless.
  allowMessagesFrom MessagePolicy @default(EVERYONE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience Experience[]
  education  Education[]
  skills     ProfileSkill[]
  portfolio  PortfolioItem[]
  followers  Follow[]        @relation("FollowFollowee")
  following  Follow[]        @relation("FollowFollower")

  @@index([handle(ops: raw("text_pattern_ops"))], map: "profiles_handle_pattern_idx")
  @@map("profiles")
}

model Experience {
  id          String    @id @default(uuid(7))
  userId      String
  title       String
  company     String
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  description String?
  position    Int

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, position])
  @@map("experiences")
}

model Education {
  id        String  @id @default(uuid(7))
  userId    String
  school    String
  degree    String?
  field     String?
  startYear Int?
  endYear   Int?
  position  Int

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, position])
  @@map("educations")
}

model ProfileSkill {
  userId   String
  skill    String
  position Int

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, skill])
  @@map("profile_skills")
}

model PortfolioItem {
  id           String  @id @default(uuid(7))
  userId       String
  title        String
  url          String?
  mediaAssetId String?
  description  String?
  position     Int

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, position])
  @@map("portfolio_items")
}

model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower Profile @relation("FollowFollower", fields: [followerId], references: [userId], onDelete: Cascade)
  followee Profile @relation("FollowFollowee", fields: [followeeId], references: [userId], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

// ─── organizations ───────────────────────────────────────────────────────
// Membership is UserRole rows with orgId (no members table). UserRole.orgId has no FK on purpose: RBAC does not know this table.

model Organization {
  id          String   @id @default(uuid(7))
  slug        String   @unique // stored lower-case
  name        String
  logoAssetId String?
  about       String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  invites OrgInvite[]

  @@index([ownerId])
  @@map("organizations")
}

// tokenHash is the SHA-256 (hex) of the raw token; the raw token only ever exists in the invite email.
model OrgInvite {
  id          String    @id @default(uuid(7))
  orgId       String
  email       String // lower-case
  roleKey     String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, email])
  @@map("org_invites")
}

// ─── media ───

enum MediaPurpose {
  AVATAR
  BANNER
  THUMBNAIL
  GIG_GALLERY
  REEL
  COURSE_LESSON
  COURSE_RESOURCE
  COURSE_PROMO
}

enum MediaBucket {
  PUBLIC
  PRIVATE
}

enum MediaStatus {
  PENDING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

// ownerId / attachment targets are plain ids (no FKs): the media module owns this table only.
// attachedAt is set by MediaService.attach(); unattached assets older than 24 h are deleted by the cleanup job.
model MediaAsset {
  id            String       @id @default(uuid(7))
  ownerId       String
  purpose       MediaPurpose
  bucket        MediaBucket
  status        MediaStatus  @default(PENDING)
  objectKey     String
  filename      String?
  mime          String
  declaredSize  BigInt
  uploadId      String?
  durationSec   Float?
  width         Int?
  height        Int?
  renditions    Json?
  posterKey     String?
  failureReason String?
  sourceEtag    String?
  /// The organization this upload was made for (course media of an ORG course): counts against the organization's storage_gb, not the uploader's. Null for personal uploads.
  orgId         String?
  attachedAt    DateTime?
  detachedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([ownerId, createdAt])
  @@index([attachedAt, createdAt])
  @@index([ownerId, status])
  @@index([orgId, status])
  @@map("media_assets")
}

// ─── notifications ───────────────────────────────────────────────────────

// sourceEventId = outbox event id that produced the row; (userId, sourceEventId) is unique so a redelivered event cannot notify twice
// (NULLs are distinct in Postgres, so rows created outside a handler are unconstrained).
model Notification {
  id            String    @id @default(uuid(7))
  userId        String
  type          String
  title         String
  body          String
  link          String?
  data          Json?
  sourceEventId String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@unique([userId, sourceEventId])
  @@index([userId, readAt, createdAt])
  @@index([userId, id])
  @@map("notifications")
}

model NotificationPreference {
  userId String
  type   String
  inApp  Boolean
  email  Boolean

  @@id([userId, type])
  @@map("notification_preferences")
}

// ─── wallet ──────────────────────────────────────────────────────────────

enum LedgerOwnerType {
  USER
  ORG
  PLATFORM
}

enum LedgerAccountKind {
  AVAILABLE
  PENDING
  PAYOUT_LOCKED
  GATEWAY_CLEARING
  PLATFORM_REVENUE
  TAX_PAYABLE
  REFUNDS
}

model LedgerAccount {
  id        String            @id @default(uuid(7))
  ownerType LedgerOwnerType
  /// Null for PLATFORM accounts. Uniqueness uses NULLS NOT DISTINCT (hand-edited in the migration), so one platform account per kind.
  ownerId   String?
  kind      LedgerAccountKind
  currency  String            @default("INR")
  closedAt  DateTime?
  createdAt DateTime          @default(now())

  lines   LedgerLine[]
  balance AccountBalance?

  @@unique([ownerType, ownerId, kind], map: "ledger_accounts_owner_kind_key")
  @@map("ledger_accounts")
}

model JournalEntry {
  id          String   @id @default(uuid(7))
  refType     String
  refId       String
  description String
  createdAt   DateTime @default(now())

  lines LedgerLine[]

  @@unique([refType, refId, description])
  @@map("journal_entries")
}

model LedgerLine {
  id          String @id @default(uuid(7))
  entryId     String
  accountId   String
  /// Signed paise: positive credits the account, negative debits it. Every entry's lines sum to zero.
  amountPaise BigInt

  entry   JournalEntry  @relation(fields: [entryId], references: [id])
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("ledger_lines")
}

model AccountBalance {
  accountId    String   @id
  balancePaise BigInt   @default(0)
  updatedAt    DateTime @updatedAt

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@map("account_balances")
}

// ─── billing ─────────────────────────────────────────────────────────────

enum WebhookProvider {
  RAZORPAY
  RAZORPAYX
}

model WebhookEvent {
  id          String          @id @default(uuid(7))
  provider    WebhookProvider
  eventId     String
  /// sha256 (hex) of the raw signed body. The signature covers the body but not the event-id header, so a captured body
  /// replayed under a fresh header must still be recognised as a duplicate.
  bodySha256  String
  type        String
  payload     Json
  receivedAt  DateTime        @default(now())
  processedAt DateTime?
  attempts    Int             @default(0)
  lastError   String?

  @@unique([provider, eventId])
  @@unique([provider, bodySha256])
  @@index([processedAt])
  @@map("webhook_events")
}

// Plans, versions and subscriptions. `subscriptions` is the only source of an owner's plan, trial and expiry (spec 11.2).
// A price/limit/commission change is a NEW plan_versions row; existing subscribers stay on theirs. ownerId has no FK (users and
// organizations are owned by other modules).

enum PlanAudience {
  CREATOR
  ORG
}

enum PlanInterval {
  MONTH
  YEAR
}

enum SubscriptionOwnerType {
  USER
  ORG
}

/// INCOMPLETE: checkout started, first payment not yet confirmed (no entitlement).
enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Plan {
  id        String       @id @default(uuid(7))
  key       String       @unique
  name      String
  audience  PlanAudience
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  versions PlanVersion[]

  @@map("plans")
}

model PlanVersion {
  id             String       @id @default(uuid(7))
  planId         String
  pricePaise     BigInt
  interval       PlanInterval
  commissionBps  Int
  /// Keys: max_published_courses, storage_gb, reels_per_day, analytics_level, creator_coupons, org_seats (null = unlimited).
  limits         Json
  /// Created lazily on the first checkout of a paid version.
  razorpayPlanId String?      @unique
  createdAt      DateTime     @default(now())

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  orders        Order[]

  @@index([planId, interval, createdAt])
  @@map("plan_versions")
}

model Subscription {
  id                     String                @id @default(uuid(7))
  ownerType              SubscriptionOwnerType
  ownerId                String
  planVersionId          String
  status                 SubscriptionStatus
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean               @default(false)
  razorpaySubscriptionId String?               @unique
  /// PAST_DUE keeps access until this instant, then the maintenance job expires the row.
  graceEndsAt            DateTime?
  /// Downgrade booked for the end of the current period.
  scheduledPlanVersionId String?
  /// User who receives this subscription's notifications: the owner for USER subscriptions, the org owner/manager for ORG ones.
  notifyUserId           String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@index([ownerType, ownerId, status])
  @@index([status, graceEndsAt])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

// ─── orders, coupons, idempotency ────────────────────────────────────────
// Orders snapshot everything that decides the money split (commission, GST, coupon funding, the seller's plan version), so a later
// plan or setting change never re-prices a sale. An order has exactly one item in Phase 2; order_items keeps the shape open.

enum OrderStatus {
  CREATED
  PAID
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SellerOwnerType {
  USER
  ORG
}

enum CouponKind {
  PERCENT
  FLAT
}

enum CouponFunding {
  CREATOR
  PLATFORM
}

enum CouponScope {
  ALL
  SELLER
  ITEM
}

enum RedemptionStatus {
  RESERVED
  REDEEMED
  RELEASED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

model Order {
  id                 String          @id @default(uuid(7))
  buyerId            String
  status             OrderStatus     @default(CREATED)
  currency           String          @default("INR")
  /// Price before any coupon.
  listPricePaise     BigInt
  discountPaise      BigInt          @default(0)
  /// What the buyer pays: list - discount. This is the Razorpay order amount.
  totalPaise         BigInt
  couponId           String?
  couponFundedBy     CouponFunding?
  sellerOwnerType    SellerOwnerType
  sellerOwnerId      String
  /// Snapshots taken at checkout.
  commissionBps      Int
  gstBps             Int
  planVersionId      String
  razorpayOrderId    String?         @unique
  razorpayPaymentId  String?         @unique
  paidAt             DateTime?
  /// Set when the payment was captured and the sale posted but the seller module refused to deliver (permanent error); a refund follows.
  fulfilmentFailedAt DateTime?
  fulfilmentError    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  items             OrderItem[]
  invoice           Invoice?
  refunds           Refund[]
  coupon            Coupon?            @relation(fields: [couponId], references: [id], onDelete: Restrict)
  planVersion       PlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  duplicatePayments DuplicatePayment[]

  @@index([buyerId, id])
  @@index([status, createdAt])
  @@index([sellerOwnerType, sellerOwnerId])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid(7))
  orderId        String
  itemType       String
  itemId         String
  title          String
  unitPricePaise BigInt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([itemType, itemId])
  @@map("order_items")
}

/// A second captured payment against an order that is already PAID. Kept for a manual refund; never posted to the ledger.
model DuplicatePayment {
  id                String    @id @default(uuid(7))
  orderId           String
  razorpayPaymentId String    @unique
  amountPaise       BigInt
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([resolvedAt])
  @@map("duplicate_payments")
}

model Coupon {
  id        String           @id @default(uuid(7))
  /// Upper-case, unique platform-wide.
  code      String           @unique
  kind      CouponKind
  /// PERCENT: basis points (2000 = 20%). FLAT: paise.
  value     BigInt
  fundedBy  CouponFunding
  /// The seller the coupon belongs to (CREATOR) or targets (PLATFORM with scope SELLER).
  ownerType SellerOwnerType?
  ownerId   String?
  scope     CouponScope      @default(ALL)
  itemType  String?
  itemId    String?
  maxUses   Int?
  expiresAt DateTime?
  isActive  Boolean          @default(true)
  createdBy String?
  createdAt DateTime         @default(now())

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([ownerType, ownerId])
  @@map("coupons")
}

/// RESERVED at checkout (under a lock on the coupon), REDEEMED when the order is paid, RELEASED when it fails or expires.
/// RESERVED and REDEEMED count against max_uses and the one-per-user rule; the one-per-user rule is also a partial unique
/// index (couponId, userId) WHERE status IN (RESERVED, REDEEMED), added by hand in the migration.
model CouponRedemption {
  id        String           @id @default(uuid(7))
  couponId  String
  userId    String
  orderId   String           @unique
  status    RedemptionStatus @default(REDEEMED)
  createdAt DateTime         @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@index([couponId, status])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model IdempotencyRecord {
  id          String            @id @default(uuid(7))
  userId      String
  /// "METHOD /path" of the concrete request, so the same key on another resource is a different record.
  route       String
  key         String
  requestHash String
  status      IdempotencyStatus @default(IN_PROGRESS)
  statusCode  Int?
  response    Json?
  /// When the current attempt took the key; an IN_PROGRESS record older than the stale window is taken over.
  startedAt   DateTime          @default(now())
  createdAt   DateTime          @default(now())

  @@unique([userId, route, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

// ─── invoices and refunds ────────────────────────────────────────────────

/// One tax invoice per paid order or per subscription charge. The number is allocated from invoice_counters in the same transaction
/// that creates the row (gap-free per financial year); the PDF is rendered from `details` and uploaded afterwards (uploadedAt).
model Invoice {
  id              String           @id @default(uuid(7))
  number          String           @unique
  orderId         String?          @unique
  /// Razorpay payment id of a subscription charge: the idempotency key of a subscription invoice.
  paymentId       String?          @unique
  subscriptionId  String?
  /// The user who paid (order buyer / subscription notify user): may download.
  buyerUserId     String?
  /// The seller of an order invoice (null for subscriptions): may download when it is a user.
  sellerOwnerType SellerOwnerType?
  sellerOwnerId   String?
  objectKey       String
  totalPaise      BigInt
  taxPaise        BigInt
  /// Everything the PDF prints, frozen at issue time so a retry renders the same document.
  details         Json
  issuedAt        DateTime
  uploadedAt      DateTime?
  createdAt       DateTime         @default(now())

  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  creditNotes CreditNote[]

  @@index([buyerUserId, id])
  @@index([uploadedAt, createdAt])
  @@map("invoices")
}

/// Last number issued per series and financial year ("SKL/26-27" invoices, "SKC/26-27" credit notes). Locked FOR UPDATE while a number is allocated.
model InvoiceCounter {
  /// Series and financial year, e.g. "SKL/26-27".
  fy         String @id
  lastNumber Int    @default(0)

  @@map("invoice_counters")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PROCESSED
  REJECTED
  FAILED
}

/// Full refunds only in Phase 2. At most one refund per order is live (REQUESTED..PROCESSED): partial unique index
/// refunds_order_live_key (hand-written in the migration; `migrate dev` proposes to drop it: strip that line).
model Refund {
  id               String       @id @default(uuid(7))
  orderId          String
  amountPaise      BigInt
  status           RefundStatus @default(REQUESTED)
  reason           String
  /// A user id, or "system" for automatic refunds.
  requestedBy      String
  decidedBy        String?
  razorpayRefundId String?      @unique
  failureReason    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  creditNote CreditNote?

  @@index([orderId])
  @@index([status, createdAt])
  @@map("refunds")
}

/// GST credit note for a refunded order, in its own gap-free series (SKC/yy-yy/nnnnnn). Amounts are negative: they mirror the invoice.
model CreditNote {
  id              String           @id @default(uuid(7))
  number          String           @unique
  /// One credit note per refund (full refunds only).
  refundId        String           @unique
  invoiceId       String
  orderId         String
  buyerUserId     String?
  sellerOwnerType SellerOwnerType?
  sellerOwnerId   String?
  objectKey       String
  totalPaise      BigInt
  taxPaise        BigInt
  details         Json
  issuedAt        DateTime
  uploadedAt      DateTime?
  createdAt       DateTime         @default(now())

  refund  Refund  @relation(fields: [refundId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([buyerUserId, id])
  @@index([uploadedAt, createdAt])
  @@map("credit_notes")
}

// ─── payouts ─────────────────────────────────────────────────────────────

enum PayoutAccountType {
  BANK
  UPI
}

enum PayoutAccountStatus {
  PENDING
  VERIFIED
  FAILED
  /// Replaced by a newer account. Kept for the audit trail and for duplicate-PAN detection.
  INACTIVE
}

/// Where an owner's payouts go. NEVER holds a full bank account number, a full VPA or a full PAN: those travel to RazorpayX in the
/// request and are not stored (accountLast4, vpaMasked "ab***@okhdfc", panLast4 + panHash, a keyed HMAC used only to spot one PAN on two accounts).
/// One live (not INACTIVE) account per owner: partial unique index payout_accounts_owner_live_key (hand-written in the migration;
/// `migrate dev` proposes to drop it: strip that line). Replacing the account inserts a new row and retires the old one.
model PayoutAccount {
  id                     String              @id @default(uuid(7))
  ownerType              SellerOwnerType
  ownerId                String
  type                   PayoutAccountType
  status                 PayoutAccountStatus @default(PENDING)
  holderName             String
  ifsc                   String?
  accountLast4           String?
  vpaMasked              String?
  panLast4               String
  panHash                String
  /// Whether the name the bank reports for the account matches holderName (null until RazorpayX reports one).
  panNameMatch           Boolean?
  /// Set for finance review (e.g. DUPLICATE_PAN: the same PAN is on another owner's account). Never blocks the owner.
  reviewFlag             String?
  razorpayxContactId     String
  razorpayxFundAccountId String              @unique
  failureReason          String?
  verifiedAt             DateTime?
  /// Payouts to a changed account are blocked until this moment (24 h after the change, anti-fraud).
  cooldownUntil          DateTime
  createdBy              String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([ownerType, ownerId, createdAt])
  @@index([panHash])
  @@index([reviewFlag])
  @@map("payout_accounts")
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
  /// RazorpayX sent the money back after reporting it processed.
  REVERSED
  /// Could not be sent, or RazorpayX failed / rejected it before settlement.
  FAILED
  /// RazorpayX reported it processed for an amount (or without one) that does not match what was sent; funds stay locked until finance resolves it.
  MANUAL_REVIEW
}

enum PayoutMode {
  IMPS
  UPI
  NEFT
}

/// A seller's withdrawal. `amountPaise` leaves AVAILABLE when requested; the bank receives amount - tdsPaise. The tax rate (tdsBps) is
/// frozen at request time so a later settings change cannot alter a payout in flight. Ledger entries are keyed (PAYOUT, id, step).
model Payout {
  id                String          @id @default(uuid(7))
  ownerType         SellerOwnerType
  ownerId           String
  /// The account the money goes to, as it was when the payout was requested (a later account change does not redirect this payout).
  payoutAccountId   String
  amountPaise       BigInt
  tdsBps            Int
  tdsPaise          BigInt
  mode              PayoutMode
  status            PayoutStatus    @default(REQUESTED)
  requestedBy       String
  approvedBy        String?
  approvedAt        DateTime?
  razorpayxPayoutId String?         @unique
  utr               String?
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([ownerType, ownerId, id])
  @@index([status, createdAt])
  @@index([status, approvedAt])
  @@map("payouts")
}

// ─── reconciliation ──────────────────────────────────────────────────────

enum ReconciliationStatus {
  OK
  MISMATCH
  ERROR
}

/// One run per IST calendar day (`date` = "YYYY-MM-DD"); running the same day again updates the row. `details` lists every mismatch found.
model ReconciliationRun {
  id         String               @id @default(uuid(7))
  date       String               @unique
  status     ReconciliationStatus
  details    Json
  startedAt  DateTime
  finishedAt DateTime?
  createdAt  DateTime             @default(now())

  @@index([createdAt])
  @@map("reconciliation_runs")
}

// ─── courses ─────────────────────────────────────────────────────────────
// ownerId / createdById / asset ids are plain ids (no FKs): users, organizations and media belong to other modules.
// ownerType USER -> ownerId is a user id; ORG -> an organization id. slugLockedAt is set on first publish and freezes the slug.

enum CourseOwnerType {
  USER
  ORG
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

model Category {
  id       String  @id @default(uuid(7))
  slug     String  @unique
  name     String
  position Int     @default(0)
  isActive Boolean @default(true)

  courses Course[]
  gigs    Gig[]

  @@index([position])
  @@map("categories")
}

model Course {
  id                String                       @id @default(uuid(7))
  ownerType         CourseOwnerType
  ownerId           String
  slug              String                       @unique
  slugLockedAt      DateTime?
  title             String
  subtitle          String?
  description       String                       @default("")
  categoryId        String
  level             CourseLevel                  @default(ALL)
  language          String
  tags              String[]
  pricePaise        BigInt                       @default(0)
  thumbnailAssetId  String?
  promoVideoAssetId String?
  status            CourseStatus                 @default(DRAFT)
  flaggedAt         DateTime?
  flagReason        String?
  /// Set when the author submits for review; the moderator queue is oldest first.
  submittedAt       DateTime?
  /// The moderator reason for the last rejection; cleared when the course is submitted again.
  rejectionReason   String?
  publishedAt       DateTime?
  createdById       String
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  ratingAvg         Decimal?                     @db.Decimal(3, 2)
  ratingCount       Int                          @default(0)
  enrolmentCount    Int                          @default(0)
  /// The owner's display name (the creator's, or the organization's), copied here so search needs no join. Refreshed by the courses worker on profile / organization renames.
  ownerName         String                       @default("")
  /// Full-text document (simple config): title A, subtitle + tags B, description + owner name C. Maintained in code (course-search.ts), never by Prisma;
  /// its GIN index and the pg_trgm index on title are hand-written in the migration, so later `migrate dev` runs must keep them out of DROP/CREATE.
  searchVector      Unsupported("tsvector")?
  /// Enrolments of the last 30 days, refreshed hourly by the maintenance job; the "popular" sort.
  enrolments30d     Int                          @default(0)
  /// The rating as the public sees it, a STORED GENERATED column (migration): 0 until 3 learners rated. The catalog "rating" sort and its index read it; never written by the app. Prisma sees it as a column with a default: strip the generated `ALTER COLUMN "ratingShown"` from migrate dev output.
  ratingShown       Unsupported("numeric(3,2)")?

  category     Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sections     CourseSection[]
  lessons      Lesson[]
  enrolments   Enrolment[]
  quizzes      Quiz[]
  certificates Certificate[]
  reviews      Review[]
  questions    Question[]

  @@index([ownerType, ownerId, id])
  @@index([categoryId])
  @@index([status, publishedAt])
  @@index([status, submittedAt, id])
  @@map("courses")
}

// ─── curriculum ──────────────────────────────────────────────────────────
// Positions are dense (0..n-1): sections within a course, lessons within a section. Reordering rewrites them in one transaction.
// videoAssetId / resourceAssetId point at media assets (no FK: media is another module's table); quizId is set by the quizzes feature.

enum LessonType {
  VIDEO
  ARTICLE
  QUIZ
  RESOURCE
}

model CourseSection {
  id        String   @id @default(uuid(7))
  courseId  String
  title     String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, position])
  @@map("course_sections")
}

model Lesson {
  id              String     @id @default(uuid(7))
  courseId        String
  sectionId       String
  title           String
  type            LessonType
  position        Int
  isFreePreview   Boolean    @default(false)
  isRequired      Boolean    @default(true)
  videoAssetId    String?
  durationSec     Int?
  /// Sanitised Markdown, at most 50,000 characters.
  articleBody     String?
  resourceAssetId String?
  quizId          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section   CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress  LessonProgress[]
  questions Question[]

  @@index([sectionId, position])
  @@index([courseId])
  @@index([videoAssetId])
  @@index([quizId])
  @@map("lessons")
}

// ─── enrolment ───────────────────────────────────────────────────────────
// One row per (course, learner). A refund or a lost organization seat sets revokedAt; buying or enrolling again reactivates the same row.
// orderId points at a billing order (no FK: orders belong to another module). Course.enrolmentCount counts rows with revokedAt null.

enum EnrolmentSource {
  PURCHASE
  FREE
  ORG_SEAT
}

model Enrolment {
  id          String          @id @default(uuid(7))
  courseId    String
  userId      String
  source      EnrolmentSource
  orderId     String?
  createdAt   DateTime        @default(now())
  revokedAt   DateTime?
  completedAt DateTime?
  progressPct Int             @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([courseId, userId])
  @@index([userId, id])
  @@index([orderId])
  @@map("enrolments")
}

// ─── progress ────────────────────────────────────────────────────────────
// One row per (learner, lesson), written by the server only. positionSec is where the learner is in the video (resume point);
// watchedSec is the plausible watch time the server credited (never more than real elapsed time allows); lastHeartbeatAt is the
// server clock at the last accepted heartbeat. Rows outlive a refund (kept for analytics, hidden) and go with their lesson.

model LessonProgress {
  userId          String
  lessonId        String
  courseId        String
  positionSec     Int       @default(0)
  watchedSec      Float     @default(0)
  lastHeartbeatAt DateTime?
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([courseId, userId])
  @@map("lesson_progress")
}

// ─── quizzes ─────────────────────────────────────────────────────────────
// One quiz per QUIZ lesson (Lesson.quizId). Options are stored as [{id, text}] with ids that stay stable across edits; `correct` is the
// list of right option ids and is never serialised to a learner before they hold a passing attempt. Attempts keep the answers as given
// (option ids per question id) and the score at the time, so editing a quiz later never revokes a pass.

enum QuizQuestionKind {
  SINGLE
  MULTIPLE
}

model Quiz {
  id        String   @id @default(uuid(7))
  courseId  String
  passPct   Int      @default(70)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
  @@map("quizzes")
}

model QuizQuestion {
  id       String           @id @default(uuid(7))
  quizId   String
  prompt   String
  kind     QuizQuestionKind
  options  Json
  correct  Json
  position Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, position])
  @@map("quiz_questions")
}

model QuizAttempt {
  id        String   @id @default(uuid(7))
  quizId    String
  userId    String
  answers   Json
  scorePct  Int
  passed    Boolean
  createdAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, userId, createdAt])
  @@map("quiz_attempts")
}

// ─── certificates ────────────────────────────────────────────────────────
// Issued when a learner finishes a course. learnerName, courseTitle and issuerName are snapshots taken at issue time: the PDF and the
// public verify page keep saying what the certificate said, whatever is renamed later. At most one LIVE (revokedAt null) certificate per
// (userId, courseId): the partial unique index certificates_live_key is hand-written in the migration (Prisma cannot express it), so
// every later migration must keep it out of its DROP/CREATE. A revoked one stays (verify says REVOKED) and a new one may be issued.

enum CertificateState {
  PENDING_NAME
  VALID
}

model Certificate {
  id          String           @id @default(uuid(7))
  code        String           @unique
  courseId    String
  userId      String
  /// Null while PENDING_NAME: the learner never set a name, so nothing derived from their email is printed or published.
  learnerName String?
  courseTitle String
  issuerName  String
  issuedAt    DateTime
  /// Private storage key of the PDF (certificates/{id}.pdf); null until the certificate is VALID.
  objectKey   String?
  state       CertificateState @default(VALID)
  revokedAt   DateTime?

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([userId, issuedAt])
  @@index([courseId])
  @@map("certificates")
}

// ─── reviews and lesson Q&A ──────────────────────────────────────────────
// Plain text only (sanitised on write). One review per (course, learner). hiddenAt hides a row from everyone but its author: hiddenBy is the
// moderator who hid it, or null when the system did (the learner's enrolment ended; reactivating the enrolment brings it back). Course.ratingAvg
// / ratingCount are computed from the rows with hiddenAt null, in the transaction of every change, with the course row locked.

model Review {
  id           String    @id @default(uuid(7))
  courseId     String
  userId       String
  rating       Int
  body         String?
  reply        String?
  repliedAt    DateTime?
  repliedById  String?
  hiddenAt     DateTime?
  hiddenBy     String?
  hiddenReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId, hiddenAt, id])
  @@map("reviews")
}

model Question {
  id           String    @id @default(uuid(7))
  lessonId     String
  courseId     String
  userId       String
  body         String
  hiddenAt     DateTime?
  hiddenBy     String?
  hiddenReason String?
  createdAt    DateTime  @default(now())

  lesson  Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([lessonId, hiddenAt, id])
  @@map("questions")
}

model Answer {
  id           String    @id @default(uuid(7))
  questionId   String
  userId       String
  body         String
  isInstructor Boolean   @default(false)
  hiddenAt     DateTime?
  hiddenBy     String?
  hiddenReason String?
  createdAt    DateTime  @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, hiddenAt, id])
  @@map("answers")
}

// ─── reels ───────────────────────────────────────────────────────────────
// A reel is one REEL media asset (mediaAssetId, no FK: media is another module's table) plus a plain-text caption. It starts PROCESSING while the
// video is transcoded (the media.ready / media.failed handlers move it), is PUBLISHED when the creator's reels_per_day allows it (counted per IST day
// on `publishedAt`, under a per-creator advisory lock) and LIMIT_REACHED when it does not. DELETED rows keep `publishedAt` on purpose: the
// daily limit counts publish events, so deleting and re-posting never gives a slot back. Counters are denormalised and only ever moved in the
// transaction of the row change that justifies them. linkedCourseId points at a course (no FK: courses is another module).

enum ReelStatus {
  PROCESSING
  PUBLISHED
  HIDDEN
  REMOVED
  DELETED
  FAILED
  LIMIT_REACHED
}

model Reel {
  id              String                   @id @default(uuid(7))
  creatorId       String
  mediaAssetId    String                   @unique
  caption         String                   @default("")
  /// Parsed from the caption on every write (lower-case NFC, at most 10); `hashtags` rows count the PUBLISHED reels that carry each tag.
  hashtags        String[]
  linkedCourseId  String?
  /// A live gig of the creator (no FK: gigs is another module). At most one of linkedCourseId / linkedGigId is set.
  linkedGigId     String?
  status          ReelStatus               @default(PROCESSING)
  commentsEnabled Boolean                  @default(true)
  failureReason   String?
  publishedAt     DateTime?
  deletedAt       DateTime?
  likeCount       Int                      @default(0)
  commentCount    Int                      @default(0)
  saveCount       Int                      @default(0)
  shareCount      Int                      @default(0)
  viewCount       Int                      @default(0)
  watchSecTotal   Int                      @default(0)
  /// Full-text document (simple config): caption + hashtags. Kept by the reels_search_vector trigger, never by Prisma; its GIN index and the
  /// pg_trgm index on caption are hand-written in the migration, so later `migrate dev` runs must keep them out of DROP/CREATE.
  searchVector    Unsupported("tsvector")?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  likes    ReelLike[]
  saves    ReelSave[]
  shares   ReelShare[]
  comments ReelComment[]
  daily    ReelViewDaily[]
  seen     ReelSeen[]

  @@index([creatorId, publishedAt, id])
  @@index([creatorId, status, id])
  /// The feed / hashtag-recent / candidate scans: PUBLISHED reels newest first.
  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([hashtags], type: Gin)
  @@map("reels")
}

model Hashtag {
  tag        String   @id
  reelCount  Int      @default(0)
  lastUsedAt DateTime

  @@map("hashtags")
}

// ─── reel engagement ─────────────────────────────────────────────────────
// Likes and saves are one row per (reel, user); the counters on the reel move only when a row is really inserted or deleted, in the same
// transaction. A share is recorded once per (reel, user, IST day) (anonymous shares are not recorded). Comments are plain text with one level of
// replies (parentId is always a top-level comment); a deleted comment keeps its row (status DELETED) so a thread with replies survives.
// reel.commentCount counts the VISIBLE rows.

model ReelLike {
  reelId    String
  userId    String
  createdAt DateTime @default(now())

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@id([reelId, userId])
  @@index([userId, createdAt])
  @@map("reel_likes")
}

model ReelSave {
  reelId    String
  userId    String
  createdAt DateTime @default(now())

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@id([reelId, userId])
  @@index([userId, createdAt, reelId])
  @@map("reel_saves")
}

model ReelShare {
  id        String   @id @default(uuid(7))
  reelId    String
  userId    String?
  channel   String
  /// IST calendar day ("YYYY-MM-DD") of the share: with the reel and user it makes the share count once a day.
  day       String
  createdAt DateTime @default(now())

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([reelId, userId, day])
  @@index([reelId, createdAt])
  @@map("reel_shares")
}

enum ReelCommentStatus {
  VISIBLE
  HIDDEN
  REMOVED
  DELETED
}

model ReelComment {
  id        String            @id @default(uuid(7))
  reelId    String
  userId    String
  /// The top-level comment this replies to; null for a top-level comment.
  parentId  String?
  body      String
  status    ReelCommentStatus @default(VISIBLE)
  editedAt  DateTime?
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  reel    Reel          @relation(fields: [reelId], references: [id], onDelete: Cascade)
  parent  ReelComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ReelComment[] @relation("CommentReplies")

  @@index([reelId, parentId, id])
  @@index([parentId, status, id])
  @@map("reel_comments")
}

// ─── reel views ──────────────────────────────────────────────────────────
// Views are counted in Redis first (see ReelViewTracker) and flushed to Postgres every minute (ReelViewFlusher). ReelViewFlush records every
// flush batch that has been applied, so a batch re-applied after a crash changes nothing.

model ReelViewDaily {
  reelId        String
  /// IST calendar day ("YYYY-MM-DD").
  day           String
  views         Int      @default(0)
  watchSec      Int      @default(0)
  /// Approximate (a HyperLogLog count of the viewers whose view was counted that day).
  uniqueViewers Int      @default(0)
  /// Clicks on the "View course" card (one per viewer per reel per IST day), flushed with the views.
  linkClicks    Int      @default(0)
  updatedAt     DateTime @default(now()) @updatedAt

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@id([reelId, day])
  @@map("reel_view_daily")
}

/// What a signed-in user has watched: feeds "already seen" ranking.
model ReelSeen {
  userId     String
  reelId     String
  lastSeenAt DateTime
  /// Share of the reel's length watched in the latest beacon, 0..100.
  watchedPct Int      @default(0)

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@id([userId, reelId])
  @@index([userId, lastSeenAt])
  @@map("reel_seen")
}

model ReelViewFlush {
  id        String   @id
  appliedAt DateTime

  @@map("reel_view_flushes")
}

/// How much a signed-in user engages with a topic: key "tag:<hashtag>" or "cat:<categoryId>". Weights decay 2% a day, applied lazily on read and update.
model UserInterest {
  userId    String
  key       String
  weight    Float
  updatedAt DateTime

  @@id([userId, key])
  @@index([userId, weight(sort: Desc)])
  @@map("user_interests")
}

// ─── growth ──────────────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  SENT
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  /// Claimed by the sender and queued (or about to be); the mail worker turns it into SENT, SKIPPED or FAILED. Never claimed twice.
  SENDING
  SENT
  SKIPPED
  FAILED
  /// SENDING for more than 24 hours with no word from the mail worker: it may or may not have gone out, so it is never sent again.
  UNKNOWN
}

/// A promotional email campaign. createdById / approvedById point at users (no FK: users is another module).
model Campaign {
  id             String         @id @default(uuid(7))
  name           String
  subject        String
  /// Markdown, validated by assertSafeMarkdown; the unsubscribe footer is added by the mail template.
  bodyMarkdown   String
  /// Validated by growth's segmentSchema: roles, plan, interests, lastActive, hasPurchased.
  segment        Json
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  /// Recipient rows written when sending started.
  audienceSize   Int?
  createdById    String
  /// Whoever last changed the draft (the creator until someone else edits it); the approver can be neither the creator nor this admin.
  lastEditedById String?
  /// Required (and not the creator or the last editor) for audiences above 10,000; withdrawn by any edit.
  approvedById   String?
  approvedAt     DateTime?
  /// SHA-256 of the subject, body and segment the approver saw; the approval counts only while the campaign still hashes to this.
  approvalHash   String?
  /// Distinct recipients per Resend event: delivered, opened, clicked, bounced, complained.
  stats          Json           @default("{}")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  recipients CampaignRecipient[]

  @@index([status, scheduledAt])
  @@map("campaigns")
}

/// One member of one campaign. Written when sending starts (idempotent); claimed in batches with FOR UPDATE SKIP LOCKED.
model CampaignRecipient {
  campaignId   String
  userId       String
  status       CampaignRecipientStatus @default(PENDING)
  /// Why a recipient was skipped: account_inactive, suppressed, unsubscribed, marketing_opt_in_required, cancelled.
  skipReason   String?
  /// Set when the recipient goes PENDING -> SENDING; a row still SENDING 24 hours later becomes UNKNOWN.
  sendingAt    DateTime?
  sentAt       DateTime?
  resendId     String?                 @unique
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  complainedAt DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// ─── moderation ──────────────────────────────────────────────────────────
// The moderation module owns reports, strikes, blocks, mutes and posting restrictions. Content stays in its owner's tables (reels, reel comments,
// course reviews and Q&A): owners register a target adapter that hides / removes / restores it, and the decision lives here.

enum ReportTargetType {
  REEL
  REEL_COMMENT
  COURSE_REVIEW
  COURSE_QA
  GIG_MESSAGE
  GIG
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  SEXUAL
  VIOLENCE
  MISINFORMATION
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  UPHELD
  DISMISSED
}

model Report {
  id           String           @id @default(uuid(7))
  targetType   ReportTargetType
  targetId     String
  reporterId   String
  reason       ReportReason
  note         String?
  status       ReportStatus     @default(OPEN)
  createdAt    DateTime         @default(now())
  decidedBy    String?
  decidedAt    DateTime?
  /// The moderator's note on the decision (the same note for every report decided together).
  decisionNote String?

  @@unique([targetType, targetId, reporterId])
  @@index([status, targetType, targetId])
  @@index([reporterId, createdAt])
  @@map("reports")
}

/// Content held back by the report threshold, awaiting a moderator. One row per target; deleted when a moderator decides.
model ModerationHold {
  targetType ReportTargetType
  targetId   String
  createdAt  DateTime         @default(now())

  @@id([targetType, targetId])
  @@map("moderation_holds")
}

/// One per upheld decision (not per report). `reportId` is one of the reports decided together.
model Strike {
  id        String   @id @default(uuid(7))
  userId    String
  reportId  String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, expiresAt])
  @@map("strikes")
}

/// A user barred from posting reels and comments until `until` (set when the third active strike lands).
model UserRestriction {
  userId    String   @id
  until     DateTime
  reason    String
  updatedAt DateTime @updatedAt

  @@map("user_restrictions")
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model UserMute {
  userId    String
  mutedId   String
  createdAt DateTime @default(now())

  @@id([userId, mutedId])
  @@map("user_mutes")
}

// ─── gigs ────────────────────────────────────────────────────────────────

enum GigStatus {
  DRAFT
  ACTIVE
  PAUSED
  /// Held back by the report threshold or a moderator, awaiting a decision.
  HIDDEN
  REMOVED
  DELETED
}

enum GigTier {
  BASIC
  STANDARD
  PREMIUM
}

/// A creator's service listing. Display only: Skiller does not process gig payments (see `gig_orders`).
model Gig {
  id                 String                   @id @default(uuid(7))
  sellerId           String
  slug               String                   @unique
  title              String
  /// Markdown, validated by assertSafeMarkdown.
  description        String                   @default("")
  categoryId         String
  tags               String[]
  status             GigStatus                @default(DRAFT)
  coverAssetId       String?
  /// The lowest package price (paise), kept by the gigs service on every package write; the catalog filters and sorts on it.
  startingPricePaise BigInt?
  /// Full-text document (simple config): title A, tags B, description C. Kept by the gigs_search_vector trigger, never by Prisma; its partial GIN indexes are hand-written.
  searchVector       Unsupported("tsvector")?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  publishedAt        DateTime?

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  packages GigPackage[]
  gallery  GigGalleryItem[]
  faqs     GigFaq[]

  @@index([sellerId, status, id])
  @@index([categoryId])
  @@map("gigs")
}

model GigPackage {
  gigId        String
  tier         GigTier
  name         String
  description  String   @default("")
  /// Integer paise, display only.
  pricePaise   BigInt
  deliveryDays Int
  revisions    Int
  features     String[]

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@id([gigId, tier])
  @@map("gig_packages")
}

model GigGalleryItem {
  gigId    String
  assetId  String
  position Int

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@id([gigId, assetId])
  @@index([gigId, position])
  @@map("gig_gallery_items")
}

model GigFaq {
  id       String @id @default(uuid(7))
  gigId    String
  question String
  answer   String
  position Int

  gig Gig @relation(fields: [gigId], references: [id], onDelete: Cascade)

  @@index([gigId, position])
  @@map("gig_faqs")
}

enum GigOrderStatus {
  PENDING
}

/// RESERVED, UNUSED: the shape of a future escrowed gig order. Nothing reads or writes it, there is no service or route, and the `gig_orders` feature flag stays off.
model GigOrder {
  id          String         @id @default(uuid(7))
  gigId       String
  packageTier GigTier
  buyerId     String
  sellerId    String
  pricePaise  BigInt
  status      GigOrderStatus @default(PENDING)
  createdAt   DateTime       @default(now())

  @@index([gigId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("gig_orders")
}

// ─── messaging ───────────────────────────────────────────────────────────

enum MessagePolicy {
  EVERYONE
  FOLLOWING
  NONE
}

enum ConversationKind {
  DIRECT
}

enum MessageStatus {
  VISIBLE
  HIDDEN
  REMOVED
}

/// A one-to-one conversation. `pairKey` is the two user ids in sorted order ("low:high"): unique, so a pair has one conversation whoever starts it.
/// `gigId` is the gig the pair last talked about (no foreign key: gigs belong to another module).
model Conversation {
  id            String           @id @default(uuid(7))
  kind          ConversationKind @default(DIRECT)
  gigId         String?
  pairKey       String           @unique
  createdAt     DateTime         @default(now())
  /// Strictly increases with every message (see MessagingService.append); the list order and the base of "unread".
  lastMessageAt DateTime         @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt, id])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  userId         String
  /// Everything created up to this moment is read; null = nothing read yet.
  lastReadAt     DateTime?
  archivedAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, archivedAt])
  @@map("conversation_participants")
}

model Message {
  id             String        @id @default(uuid(7))
  conversationId String
  senderId       String
  /// Plain text, at most 4000 characters. Shown only while status is VISIBLE.
  body           String
  status         MessageStatus @default(VISIBLE)
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, id])
  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

// ─── analytics ───────────────────────────────────────────────────────────
// One row per (IST day, metric key), rebuilt by the nightly rollup from each module's MetricsProvider (idempotent: a re-run overwrites the day).
// Money keys end in `_paise` (integer paise); `dau` / `wau` / `mau` are approximate (Redis HyperLogLog); `*_active*` / `gigs_active` are levels
// taken when the rollup ran. The dashboards read only this table.

model DailyMetric {
  /// IST calendar day ("YYYY-MM-DD").
  day       String
  key       String
  value     BigInt
  updatedAt DateTime @default(now()) @updatedAt

  @@id([day, key])
  @@map("daily_metrics")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── admin ───────────────────────────────────────────────────────────────

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  rules     Json?
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}

// ─── outbox ──────────────────────────────────────────────────────────────

model OutboxEvent {
  id          String    @id @default(uuid(7))
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)

  @@index([publishedAt])
  @@map("outbox_events")
}

// ─── mail ────────────────────────────────────────────────────────────────

model EmailSuppression {
  email     String   @id
  reason    String
  createdAt DateTime @default(now())

  @@map("email_suppressions")
}

// ─── identity ────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OtpPurpose {
  LOGIN
  STEP_UP
}

model User {
  id              String     @id @default(uuid(7))
  email           String     @unique // stored lower-case
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions Session[]
  roles    UserRole[]

  @@map("users")
}

model OtpChallenge {
  id         String     @id @default(uuid(7))
  email      String
  purpose    OtpPurpose
  userId     String?
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
  @@map("otp_challenges")
}

model Session {
  id           String    @id @default(uuid(7))
  userId       String
  familyId     String
  refreshHash  String    @unique
  previousHash String?   @unique
  rotatedAt    DateTime?
  userAgent    String
  ip           String
  lastUsedAt   DateTime
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

// ─── rbac ────────────────────────────────────────────────────────────────

enum RoleScope {
  PLATFORM
  ORG
}

model Permission {
  id          String   @id @default(uuid(7))
  key         String   @unique
  description String
  module      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String    @id @default(uuid(7))
  key         String    @unique
  name        String
  scope       RoleScope
  isSystem    Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// orgId is NULL for platform-wide grants. The unique index is recreated as NULLS NOT DISTINCT in the migration
// (Postgres 15+), so a platform grant cannot be duplicated either.
model UserRole {
  id          String    @id @default(uuid(7))
  userId      String
  roleId      String
  orgId       String?
  grantedById String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, orgId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── audit ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid(7))
  actorId    String?
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  ip         String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

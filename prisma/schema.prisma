generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── admin ───────────────────────────────────────────────────────────────

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  rules     Json?
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}

// ─── outbox ──────────────────────────────────────────────────────────────

model OutboxEvent {
  id          String    @id @default(uuid(7))
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)

  /// Set when delivery to the handlers was given up (all job attempts failed); lastError is the final error message.
  deadAt    DateTime?
  lastError String?

  /// Relay claim: set (with a per-cycle token) when a relay picks the row up; reclaimable if publishedAt stays null for 60 s.
  claimedAt  DateTime?
  claimToken String?

  @@index([publishedAt])
  @@index([deadAt])
  @@map("outbox_events")
}

// ─── mail ────────────────────────────────────────────────────────────────

model EmailSuppression {
  email     String   @id
  reason    String
  createdAt DateTime @default(now())

  @@map("email_suppressions")
}

// ─── identity ────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OtpPurpose {
  LOGIN
  STEP_UP
}

model User {
  id              String     @id @default(uuid(7))
  email           String     @unique // stored lower-case
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions  Session[]
  roles     UserRole[]
  profile   Profile?
  ownedOrgs Organization[]

  // text_pattern_ops makes LIKE 'prefix%' index-backed regardless of collation (admin search).
  @@index([email(ops: raw("text_pattern_ops"))], map: "users_email_pattern_idx")
  @@map("users")
}

model OtpChallenge {
  id         String     @id @default(uuid(7))
  email      String
  purpose    OtpPurpose
  userId     String?
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
  @@map("otp_challenges")
}

model Session {
  id           String    @id @default(uuid(7))
  userId       String
  familyId     String
  refreshHash  String    @unique
  previousHash String?   @unique
  rotatedAt    DateTime?
  userAgent    String
  ip           String
  lastUsedAt   DateTime
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

// ─── rbac ────────────────────────────────────────────────────────────────

enum RoleScope {
  PLATFORM
  ORG
}

model Permission {
  id          String   @id @default(uuid(7))
  key         String   @unique
  description String
  module      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String    @id @default(uuid(7))
  key         String    @unique
  name        String
  scope       RoleScope
  isSystem    Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// orgId is NULL for platform-wide grants. The unique index is recreated as NULLS NOT DISTINCT in the migration
// (Postgres 15+), so a platform grant cannot be duplicated either.
model UserRole {
  id          String    @id @default(uuid(7))
  userId      String
  roleId      String
  orgId       String?
  grantedById String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, orgId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── audit ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid(7))
  actorId    String?
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  ip         String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ─── users (profiles) ────────────────────────────────────────────────────

// handle is stored lower-case, so a plain unique index gives case-insensitive uniqueness. Always normalise before write/lookup.
model Profile {
  userId         String    @id
  handle         String    @unique
  displayName    String
  headline       String?
  about          String?
  avatarAssetId  String?
  bannerAssetId  String?
  location       String?
  links          Json      @default("[]")
  followersCount Int       @default(0)
  followingCount Int       @default(0)
  isCreator      Boolean   @default(false)
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience Experience[]
  education  Education[]
  skills     ProfileSkill[]
  portfolio  PortfolioItem[]
  followers  Follow[]        @relation("FollowFollowee")
  following  Follow[]        @relation("FollowFollower")

  @@index([handle(ops: raw("text_pattern_ops"))], map: "profiles_handle_pattern_idx")
  @@map("profiles")
}

model Experience {
  id          String    @id @default(uuid(7))
  userId      String
  title       String
  company     String
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  description String?
  position    Int

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, position])
  @@map("experiences")
}

model Education {
  id        String  @id @default(uuid(7))
  userId    String
  school    String
  degree    String?
  field     String?
  startYear Int?
  endYear   Int?
  position  Int

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, position])
  @@map("educations")
}

model ProfileSkill {
  userId   String
  skill    String
  position Int

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, skill])
  @@map("profile_skills")
}

model PortfolioItem {
  id           String  @id @default(uuid(7))
  userId       String
  title        String
  url          String?
  mediaAssetId String?
  description  String?
  position     Int

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, position])
  @@map("portfolio_items")
}

model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower Profile @relation("FollowFollower", fields: [followerId], references: [userId], onDelete: Cascade)
  followee Profile @relation("FollowFollowee", fields: [followeeId], references: [userId], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

// ─── organizations ───────────────────────────────────────────────────────
// Membership is UserRole rows with orgId (no members table). UserRole.orgId has no FK on purpose: RBAC does not know this table.

model Organization {
  id          String   @id @default(uuid(7))
  slug        String   @unique // stored lower-case
  name        String
  logoAssetId String?
  about       String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  invites OrgInvite[]

  @@index([ownerId])
  @@map("organizations")
}

// tokenHash is the SHA-256 (hex) of the raw token; the raw token only ever exists in the invite email.
model OrgInvite {
  id          String    @id @default(uuid(7))
  orgId       String
  email       String // lower-case
  roleKey     String
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, email])
  @@map("org_invites")
}

// ─── media ───

enum MediaPurpose {
  AVATAR
  BANNER
  THUMBNAIL
  GIG_GALLERY
  REEL
  COURSE_LESSON
  COURSE_RESOURCE
}

enum MediaBucket {
  PUBLIC
  PRIVATE
}

enum MediaStatus {
  PENDING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

// ownerId / attachment targets are plain ids (no FKs): the media module owns this table only.
// attachedAt is set by MediaService.attach(); unattached assets older than 24 h are deleted by the cleanup job.
model MediaAsset {
  id            String       @id @default(uuid(7))
  ownerId       String
  purpose       MediaPurpose
  bucket        MediaBucket
  status        MediaStatus  @default(PENDING)
  objectKey     String
  filename      String?
  mime          String
  declaredSize  BigInt
  uploadId      String?
  durationSec   Float?
  width         Int?
  height        Int?
  renditions    Json?
  posterKey     String?
  failureReason String?
  sourceEtag    String?
  attachedAt    DateTime?
  detachedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([ownerId, createdAt])
  @@index([attachedAt, createdAt])
  @@index([ownerId, status])
  @@map("media_assets")
}

// ─── notifications ───────────────────────────────────────────────────────

// sourceEventId = outbox event id that produced the row; (userId, sourceEventId) is unique so a redelivered event cannot notify twice
// (NULLs are distinct in Postgres, so rows created outside a handler are unconstrained).
model Notification {
  id            String    @id @default(uuid(7))
  userId        String
  type          String
  title         String
  body          String
  link          String?
  data          Json?
  sourceEventId String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@unique([userId, sourceEventId])
  @@index([userId, readAt, createdAt])
  @@index([userId, id])
  @@map("notifications")
}

model NotificationPreference {
  userId String
  type   String
  inApp  Boolean
  email  Boolean

  @@id([userId, type])
  @@map("notification_preferences")
}

// ─── wallet ──────────────────────────────────────────────────────────────

enum LedgerOwnerType {
  USER
  ORG
  PLATFORM
}

enum LedgerAccountKind {
  AVAILABLE
  PENDING
  PAYOUT_LOCKED
  GATEWAY_CLEARING
  PLATFORM_REVENUE
  TAX_PAYABLE
  REFUNDS
}

model LedgerAccount {
  id        String            @id @default(uuid(7))
  ownerType LedgerOwnerType
  /// Null for PLATFORM accounts. Uniqueness uses NULLS NOT DISTINCT (hand-edited in the migration), so one platform account per kind.
  ownerId   String?
  kind      LedgerAccountKind
  currency  String            @default("INR")
  closedAt  DateTime?
  createdAt DateTime          @default(now())

  lines   LedgerLine[]
  balance AccountBalance?

  @@unique([ownerType, ownerId, kind], map: "ledger_accounts_owner_kind_key")
  @@map("ledger_accounts")
}

model JournalEntry {
  id          String   @id @default(uuid(7))
  refType     String
  refId       String
  description String
  createdAt   DateTime @default(now())

  lines LedgerLine[]

  @@unique([refType, refId, description])
  @@map("journal_entries")
}

model LedgerLine {
  id          String @id @default(uuid(7))
  entryId     String
  accountId   String
  /// Signed paise: positive credits the account, negative debits it. Every entry's lines sum to zero.
  amountPaise BigInt

  entry   JournalEntry  @relation(fields: [entryId], references: [id])
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("ledger_lines")
}

model AccountBalance {
  accountId    String   @id
  balancePaise BigInt   @default(0)
  updatedAt    DateTime @updatedAt

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@map("account_balances")
}

// ─── billing ─────────────────────────────────────────────────────────────

enum WebhookProvider {
  RAZORPAY
  RAZORPAYX
}

model WebhookEvent {
  id          String          @id @default(uuid(7))
  provider    WebhookProvider
  eventId     String
  /// sha256 (hex) of the raw signed body. The signature covers the body but not the event-id header, so a captured body
  /// replayed under a fresh header must still be recognised as a duplicate.
  bodySha256  String
  type        String
  payload     Json
  receivedAt  DateTime        @default(now())
  processedAt DateTime?
  attempts    Int             @default(0)
  lastError   String?

  @@unique([provider, eventId])
  @@unique([provider, bodySha256])
  @@index([processedAt])
  @@map("webhook_events")
}

// Plans, versions and subscriptions. `subscriptions` is the only source of an owner's plan, trial and expiry (spec 11.2).
// A price/limit/commission change is a NEW plan_versions row; existing subscribers stay on theirs. ownerId has no FK (users and
// organizations are owned by other modules).

enum PlanAudience {
  CREATOR
  ORG
}

enum PlanInterval {
  MONTH
  YEAR
}

enum SubscriptionOwnerType {
  USER
  ORG
}

/// INCOMPLETE: checkout started, first payment not yet confirmed (no entitlement).
enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Plan {
  id        String       @id @default(uuid(7))
  key       String       @unique
  name      String
  audience  PlanAudience
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  versions PlanVersion[]

  @@map("plans")
}

model PlanVersion {
  id             String       @id @default(uuid(7))
  planId         String
  pricePaise     BigInt
  interval       PlanInterval
  commissionBps  Int
  /// Keys: max_published_courses, storage_gb, reels_per_day, analytics_level, creator_coupons, org_seats (null = unlimited).
  limits         Json
  /// Created lazily on the first checkout of a paid version.
  razorpayPlanId String?      @unique
  createdAt      DateTime     @default(now())

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  orders        Order[]

  @@index([planId, interval, createdAt])
  @@map("plan_versions")
}

model Subscription {
  id                     String                @id @default(uuid(7))
  ownerType              SubscriptionOwnerType
  ownerId                String
  planVersionId          String
  status                 SubscriptionStatus
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean               @default(false)
  razorpaySubscriptionId String?               @unique
  /// PAST_DUE keeps access until this instant, then the maintenance job expires the row.
  graceEndsAt            DateTime?
  /// Downgrade booked for the end of the current period.
  scheduledPlanVersionId String?
  /// User who receives this subscription's notifications: the owner for USER subscriptions, the org owner/manager for ORG ones.
  notifyUserId           String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@index([ownerType, ownerId, status])
  @@index([status, graceEndsAt])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

// ─── orders, coupons, idempotency ────────────────────────────────────────
// Orders snapshot everything that decides the money split (commission, GST, coupon funding, the seller's plan version), so a later
// plan or setting change never re-prices a sale. An order has exactly one item in Phase 2; order_items keeps the shape open.

enum OrderStatus {
  CREATED
  PAID
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SellerOwnerType {
  USER
  ORG
}

enum CouponKind {
  PERCENT
  FLAT
}

enum CouponFunding {
  CREATOR
  PLATFORM
}

enum CouponScope {
  ALL
  SELLER
  ITEM
}

enum RedemptionStatus {
  RESERVED
  REDEEMED
  RELEASED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

model Order {
  id                String          @id @default(uuid(7))
  buyerId           String
  status            OrderStatus     @default(CREATED)
  currency          String          @default("INR")
  /// Price before any coupon.
  listPricePaise    BigInt
  discountPaise     BigInt          @default(0)
  /// What the buyer pays: list - discount. This is the Razorpay order amount.
  totalPaise        BigInt
  couponId          String?
  couponFundedBy    CouponFunding?
  sellerOwnerType   SellerOwnerType
  sellerOwnerId     String
  /// Snapshots taken at checkout.
  commissionBps     Int
  gstBps            Int
  planVersionId     String
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?         @unique
  paidAt            DateTime?
  /// Set when the payment was captured and the sale posted but the seller module refused to deliver (permanent error); a refund follows.
  fulfilmentFailedAt DateTime?
  fulfilmentError   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items             OrderItem[]
  invoice           Invoice?
  refunds           Refund[]
  coupon            Coupon?         @relation(fields: [couponId], references: [id], onDelete: Restrict)
  planVersion       PlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  duplicatePayments DuplicatePayment[]

  @@index([buyerId, id])
  @@index([status, createdAt])
  @@index([sellerOwnerType, sellerOwnerId])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid(7))
  orderId        String
  itemType       String
  itemId         String
  title          String
  unitPricePaise BigInt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([itemType, itemId])
  @@map("order_items")
}

/// A second captured payment against an order that is already PAID. Kept for a manual refund; never posted to the ledger.
model DuplicatePayment {
  id                String    @id @default(uuid(7))
  orderId           String
  razorpayPaymentId String    @unique
  amountPaise       BigInt
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([resolvedAt])
  @@map("duplicate_payments")
}

model Coupon {
  id        String        @id @default(uuid(7))
  /// Upper-case, unique platform-wide.
  code      String        @unique
  kind      CouponKind
  /// PERCENT: basis points (2000 = 20%). FLAT: paise.
  value     BigInt
  fundedBy  CouponFunding
  /// The seller the coupon belongs to (CREATOR) or targets (PLATFORM with scope SELLER).
  ownerType SellerOwnerType?
  ownerId   String?
  scope     CouponScope   @default(ALL)
  itemType  String?
  itemId    String?
  maxUses   Int?
  expiresAt DateTime?
  isActive  Boolean       @default(true)
  createdBy String?
  createdAt DateTime      @default(now())

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([ownerType, ownerId])
  @@map("coupons")
}

/// RESERVED at checkout (under a lock on the coupon), REDEEMED when the order is paid, RELEASED when it fails or expires.
/// RESERVED and REDEEMED count against max_uses and the one-per-user rule; the one-per-user rule is also a partial unique
/// index (couponId, userId) WHERE status IN (RESERVED, REDEEMED), added by hand in the migration.
model CouponRedemption {
  id        String           @id @default(uuid(7))
  couponId  String
  userId    String
  orderId   String           @unique
  status    RedemptionStatus @default(REDEEMED)
  createdAt DateTime         @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@index([couponId, status])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model IdempotencyRecord {
  id          String            @id @default(uuid(7))
  userId      String
  /// "METHOD /path" of the concrete request, so the same key on another resource is a different record.
  route       String
  key         String
  requestHash String
  status      IdempotencyStatus @default(IN_PROGRESS)
  statusCode  Int?
  response    Json?
  /// When the current attempt took the key; an IN_PROGRESS record older than the stale window is taken over.
  startedAt   DateTime          @default(now())
  createdAt   DateTime          @default(now())

  @@unique([userId, route, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

// ─── invoices and refunds ────────────────────────────────────────────────

/// One tax invoice per paid order or per subscription charge. The number is allocated from invoice_counters in the same transaction
/// that creates the row (gap-free per financial year); the PDF is rendered from `details` and uploaded afterwards (uploadedAt).
model Invoice {
  id              String           @id @default(uuid(7))
  number          String           @unique
  orderId         String?          @unique
  /// Razorpay payment id of a subscription charge: the idempotency key of a subscription invoice.
  paymentId       String?          @unique
  subscriptionId  String?
  /// The user who paid (order buyer / subscription notify user): may download.
  buyerUserId     String?
  /// The seller of an order invoice (null for subscriptions): may download when it is a user.
  sellerOwnerType SellerOwnerType?
  sellerOwnerId   String?
  objectKey       String
  totalPaise      BigInt
  taxPaise        BigInt
  /// Everything the PDF prints, frozen at issue time so a retry renders the same document.
  details         Json
  issuedAt        DateTime
  uploadedAt      DateTime?
  createdAt       DateTime         @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([buyerUserId, id])
  @@index([uploadedAt, createdAt])
  @@map("invoices")
}

/// Last number issued per financial year ("2026-27"). Locked FOR UPDATE while a number is allocated.
model InvoiceCounter {
  fy         String @id
  lastNumber Int    @default(0)

  @@map("invoice_counters")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PROCESSED
  REJECTED
  FAILED
}

/// Full refunds only in Phase 2. At most one refund per order is live (REQUESTED..PROCESSED): partial unique index
/// refunds_order_live_key (hand-written in the migration; `migrate dev` proposes to drop it: strip that line).
model Refund {
  id               String       @id @default(uuid(7))
  orderId          String
  amountPaise      BigInt
  status           RefundStatus @default(REQUESTED)
  reason           String
  /// A user id, or "system" for automatic refunds.
  requestedBy      String
  decidedBy        String?
  razorpayRefundId String?      @unique
  failureReason    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("refunds")
}
